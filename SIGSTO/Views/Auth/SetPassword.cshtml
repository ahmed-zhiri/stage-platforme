@{
    ViewData["Title"] = "Creer un mot de passe";
    Layout = "_Layout";
}

<div class="auth-container">
    <div class="auth-card">
        <h1>Mot de passe</h1>
        <p class="subtitle">Creez votre mot de passe pour finaliser l'inscription</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post">
            <input type="hidden" name="userId" value="@ViewBag.UserId" />
            <div class="form-group">
                <label>Mot de passe</label>
                <input type="password" name="password" class="form-control" minlength="6" required />
            </div>
            <div class="form-group">
                <label>Confirmer le mot de passe</label>
                <input type="password" name="confirmPassword" class="form-control" minlength="6" required />
            </div>
            <button type="submit" class="btn btn-primary">Creer le mot de passe</button>
        </form>
    </div>
</div>
