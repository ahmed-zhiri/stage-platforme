@{
    ViewData["Title"] = "Connexion";
    Layout = "_Layout";
}

<div class="auth-container">
    <div class="auth-card">
        <h1>Tremplin</h1>
        <p class="subtitle">Plateforme de gestion des stages - ONEE</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post">
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" class="form-control" placeholder="votre@email.ma" required />
            </div>
            <div class="form-group">
                <label>Mot de passe</label>
                <input type="password" name="password" class="form-control" placeholder="Mot de passe" required />
            </div>
            <button type="submit" class="btn btn-primary">Se connecter</button>
        </form>

        <div class="links">
            <p>Pas encore de compte ? <a href="/Auth/Register">Creer un compte etudiant</a></p>
        </div>
    </div>
</div>
