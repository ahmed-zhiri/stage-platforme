@model SIGSTO.Models.Etudiant
@{
    ViewData["Title"] = "Mon profil";
}

<div class="page-header">
    <h1>Mon profil</h1>
</div>

<div class="card">
    <form method="post">
        <div class="form-row">
            <div class="form-group">
                <label>Nom</label>
                <input type="text" class="form-control" value="@Model?.Nom" disabled />
            </div>
            <div class="form-group">
                <label>Prenom</label>
                <input type="text" class="form-control" value="@Model?.Prenom" disabled />
            </div>
        </div>
        <div class="form-group">
            <label>Email</label>
            <input type="email" class="form-control" value="@Model?.Email" disabled />
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Etablissement</label>
                <input type="text" name="etablissement" class="form-control" value="@Model?.Etablissement" />
            </div>
            <div class="form-group">
                <label>Filiere</label>
                <input type="text" name="filiere" class="form-control" value="@Model?.Filiere" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label>Date de naissance</label>
                <input type="date" name="dateNaissance" class="form-control" value="@Model?.DateNaissance?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="form-group">
                <label>Sexe</label>
                <select name="sexe" class="form-control">
                    <option value="">-- Choisir --</option>
                    @if (Model?.Sexe == "Homme") { <option value="Homme" selected="selected">Homme</option> } else { <option value="Homme">Homme</option> }
                    @if (Model?.Sexe == "Femme") { <option value="Femme" selected="selected">Femme</option> } else { <option value="Femme">Femme</option> }
                </select>
            </div>
        </div>
        <div class="form-group">
            <label>
                <input type="checkbox" name="handicap" value="true" @(Model?.Handicap == true ? "checked" : "") />
                Situation de handicap
            </label>
        </div>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
    </form>
</div>
