@model SIGSTO.Models.Candidature
@{
    ViewData["Title"] = "Detail candidature";
}

<div class="page-header">
    <h1>Candidature #@Model.Id</h1>
    <a href="/Etudiant/Dashboard" class="btn btn-secondary">Retour</a>
</div>

<div class="card">
    <h3>@Model.Offre?.Titre</h3>
    <div class="detail-grid">
        <div class="detail-item">
            <label>Type</label>
            <p>@Model.Offre?.Type</p>
        </div>
        <div class="detail-item">
            <label>Statut</label>
            <p><span class="badge badge-@Model.StatutCandidature.ToString().ToLower()">@Model.StatutCandidature</span></p>
        </div>
        <div class="detail-item">
            <label>Date de soumission</label>
            <p>@Model.DateSoumission.ToString("dd/MM/yyyy")</p>
        </div>
        <div class="detail-item">
            <label>Score CV</label>
            <p>
                <span class="score-bar"><span class="score-fill" style="width:@Model.Score%"></span></span>
                @Model.Score.ToString("F1")%
            </p>
        </div>
        <div class="detail-item">
            <label>Encadrant</label>
            <p>@(Model.Encadrant != null ? Model.Encadrant.Prenom + " " + Model.Encadrant.Nom : "Non assigne")</p>
        </div>
    </div>
</div>

<div class="card">
    <h3>Documents soumis</h3>
    <ul style="list-style:none; padding:0">
        @if (!string.IsNullOrEmpty(Model.CheminCV))
        {
            <li style="margin-bottom:0.5rem"><a href="@Model.CheminCV" target="_blank">CV</a></li>
        }
        @if (!string.IsNullOrEmpty(Model.CheminLM))
        {
            <li style="margin-bottom:0.5rem"><a href="@Model.CheminLM" target="_blank">Lettre de motivation</a></li>
        }
        @if (!string.IsNullOrEmpty(Model.CheminLR))
        {
            <li style="margin-bottom:0.5rem"><a href="@Model.CheminLR" target="_blank">Lettre de recommandation</a></li>
        }
        @if (!string.IsNullOrEmpty(Model.CheminReleves))
        {
            <li style="margin-bottom:0.5rem"><a href="@Model.CheminReleves" target="_blank">Releves de notes</a></li>
        }
    </ul>
</div>

@if (Model.Convention != null)
{
    <div class="card">
        <h3>Convention</h3>
        <p>Statut: <span class="badge">@Model.Convention.Statut</span></p>
        @if (!string.IsNullOrEmpty(Model.Convention.CheminConv))
        {
            <p><a href="@Model.Convention.CheminConv" target="_blank">Telecharger la convention</a></p>
        }
    </div>
}

@if (Model.AccordDeStage != null)
{
    <div class="card">
        <h3>Accord de stage</h3>
        <p>Theme: @Model.AccordDeStage.Theme</p>
        <p>Periode: @Model.AccordDeStage.Periode</p>
    </div>
}

@if (Model.Evaluation != null)
{
    <div class="card">
        <h3>Evaluation</h3>
        <p>Note: @Model.Evaluation.Note / 20</p>
        <p>Appreciation: @Model.Evaluation.Appreciation</p>
    </div>
}

@if (Model.Attestation != null)
{
    <div class="card">
        <h3>Attestation</h3>
        <p>Generee le @Model.Attestation.DateGen.ToString("dd/MM/yyyy")</p>
        <a href="@Model.Attestation.CheminFichier" target="_blank" class="btn btn-sm btn-primary">Telecharger</a>
    </div>
}

@if (Model.EncadrantId != null)
{
    <div style="margin-top:1rem">
        <a href="/Message/Conversation?etudiantId=@Model.EtudiantId&encadrantId=@Model.EncadrantId" class="btn btn-primary">Messages avec l'encadrant</a>
    </div>
}
