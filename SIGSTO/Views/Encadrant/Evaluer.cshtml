@model SIGSTO.Models.Candidature
@{
    ViewData["Title"] = "Evaluer";
}

<div class="page-header">
    <h1>Evaluer: @Model.Etudiant?.Prenom @Model.Etudiant?.Nom</h1>
    <a href="/Encadrant/Dashboard" class="btn btn-secondary">Retour</a>
</div>

<div class="card">
    <p style="margin-bottom:1rem; color:#666">
        Offre: @Model.Offre?.Titre | Type: @Model.Offre?.Type
    </p>

    <form method="post">
        <input type="hidden" name="candidatureId" value="@Model.Id" />

        <div class="form-group">
            <label>Note (sur 20)</label>
            <input type="number" name="note" class="form-control" min="0" max="20" step="0.5" required />
        </div>

        <div class="form-group">
            <label>Appreciation</label>
            <textarea name="appreciation" class="form-control" rows="4" placeholder="Votre appreciation du stagiaire..." required></textarea>
        </div>

        <button type="submit" class="btn btn-success">Soumettre l'evaluation</button>
    </form>
</div>
