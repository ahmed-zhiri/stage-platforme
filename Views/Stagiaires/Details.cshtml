@model StagiaireDto
@{
    ViewData["Title"] = "Détails du stagiaire";
}

<h1 class="h3 mb-3"><i class="bi bi-person-vcard text-primary"></i> @Model.NomComplet</h1>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nom</dt><dd class="col-sm-9">@Model.Nom</dd>
            <dt class="col-sm-3">Prénom</dt><dd class="col-sm-9">@Model.Prenom</dd>
            <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Téléphone</dt><dd class="col-sm-9">@(Model.Telephone ?? "—")</dd>
            <dt class="col-sm-3">Établissement</dt><dd class="col-sm-9">@Model.Etablissement</dd>
            <dt class="col-sm-3">Spécialité</dt><dd class="col-sm-9">@(Model.Specialite ?? "—")</dd>
            <dt class="col-sm-3">Sujet</dt><dd class="col-sm-9">@(Model.Sujet ?? "—")</dd>
            <dt class="col-sm-3">Département</dt><dd class="col-sm-9">@(Model.Departement ?? "—")</dd>
            <dt class="col-sm-3">Période</dt><dd class="col-sm-9">@Model.DateDebut.ToString("dd/MM/yyyy") → @Model.DateFin.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Statut</dt><dd class="col-sm-9">@Model.StatutLibelle</dd>
            <dt class="col-sm-3">Créé le</dt><dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            @if (Model.UpdatedAt.HasValue)
            {
                <dt class="col-sm-3">Modifié le</dt><dd class="col-sm-9">@Model.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
            }
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil"></i> Modifier</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Retour à la liste</a>
</div>
