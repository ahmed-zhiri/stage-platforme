@model IEnumerable<StagesPlatform.Models.DemandeStage>

@{
    ViewData["Title"] = "Liste des demandes";
}

<h1 style="color: #022552;">Demandes de stage</h1>

<form asp-action="Index" method="get" class="row g-2 my-3">
    <div class="col-md-5">
        <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control"
               placeholder="Rechercher par sujet, stagiaire, entreprise..." />
    </div>
    <div class="col-md-3">
        <select name="filtreEtat" class="form-select" asp-items="Html.GetEnumSelectList<EtatDemande>()">
            <option value="">-- Tous les etats --</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filtrer</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Create" class="btn btn-success w-100">+ Nouvelle</a>
    </div>
</form>

<table class="table table-striped table-hover">
    <thead style="background-color: #022552; color: white;">
        <tr>
            <th>Sujet</th>
            <th>Stagiaire</th>
            <th>Entreprise</th>
            <th>Type</th>
            <th>Periode</th>
            <th>Etat</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Sujet</td>
                <td>@item.NomStagiaire</td>
                <td>@item.Entreprise</td>
                <td><span class="badge bg-secondary">@item.TypeStage</span></td>
                <td>@item.DateDebut.ToString("dd/MM/yyyy") &rarr; @item.DateFin.ToString("dd/MM/yyyy")</td>
                <td>
                    @{
                        var badgeClass = item.Etat switch
                        {
                            EtatDemande.Brouillon => "bg-secondary",
                            EtatDemande.Soumise => "bg-info",
                            EtatDemande.ValideeEncadrant => "bg-primary",
                            EtatDemande.ValideeRH => "bg-primary",
                            EtatDemande.Rejetee => "bg-danger",
                            EtatDemande.EnCours => "bg-warning text-dark",
                            EtatDemande.Terminee => "bg-success",
                            EtatDemande.Cloturee => "bg-dark",
                            _ => "bg-light text-dark"
                        };
                    }
                    <span class="badge @badgeClass">@item.Etat</span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Editer</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Aucune demande trouvee.</div>
}
