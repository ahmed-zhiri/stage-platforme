@{
    ViewData["Title"] = "Erreur";
}

<div class="text-center py-5">
    <h1 class="display-4 text-danger">Une erreur est survenue</h1>
    <p class="lead">Une erreur inattendue s'est produite lors du traitement de votre demande.</p>
    @if (ViewData["RequestId"] is string requestId && !string.IsNullOrEmpty(requestId))
    {
        <p><strong>Identifiant de requête :</strong> <code>@requestId</code></p>
    }
    <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Retour à l'accueil</a>
</div>
