@{
    ViewData["Title"] = "Accueil";
}

<div class="jumbotron p-5 rounded" style="background-color: #f2f2f2;">
    <h1 class="display-5" style="color: #022552;">Plateforme de gestion des stages</h1>
    <p class="lead">
        Preuve de concept (POC) developpee dans le cadre du stage de decouverte a l'ONEE.
        Cette application illustre la mise en oeuvre pratique des concepts de la POO en C#
        et du framework ASP.NET Core MVC 8.
    </p>
    <hr class="my-4" />
    <p>
        Elle constitue le squelette technique de la plateforme complete de gestion des stages
        decrite dans le cahier des charges fonctionnel.
    </p>
    <a class="btn btn-primary btn-lg" asp-controller="DemandesStage" asp-action="Index" role="button">
        Consulter les demandes
    </a>
    <a class="btn btn-outline-primary btn-lg" asp-controller="DemandesStage" asp-action="Create" role="button">
        Creer une demande
    </a>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Architecture MVC</h5>
                <p class="card-text">
                    Separation stricte Modele / Vue / Controleur, routing conventionnel,
                    passage de donnees fortement type.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Entity Framework Core</h5>
                <p class="card-text">
                    Approche Code First, persistence SQL Server, requetes LINQ to Entities
                    et suivi des changements.
                </p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">POO et validation</h5>
                <p class="card-text">
                    Data Annotations, model binding, encapsulation des regles metier
                    et transitions d'etat controlees.
                </p>
            </div>
        </div>
    </div>
</div>
