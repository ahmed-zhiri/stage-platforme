@{
    ViewData["Title"] = "Accueil";
}

<div class="p-5 mb-4 bg-light rounded-3 border">
    <div class="container-fluid py-3">
        <h1 class="display-5 fw-bold"><i class="bi bi-mortarboard-fill text-primary"></i> Gestion des Stagiaires</h1>
        <p class="col-md-9 fs-5 text-muted">
            Application de gestion des stagiaires de l'organisme d'accueil : back-office
            ASP.NET Core MVC + API, front-office Bootstrap / jQuery / AJAX, déployable sur IIS.
        </p>
        <a class="btn btn-primary btn-lg" asp-controller="Stagiaires" asp-action="Index">
            <i class="bi bi-people-fill"></i> Accéder aux stagiaires
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-shield-lock text-primary"></i> Authentification</h5>
                <p class="card-text text-muted">Accès sécurisé via ASP.NET Core Identity (connexion, inscription, rôles).</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-hdd-stack text-primary"></i> CRUD complet</h5>
                <p class="card-text text-muted">Création, consultation, modification et suppression des stagiaires, avec recherche et pagination.</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h5 class="card-title"><i class="bi bi-code-slash text-primary"></i> API REST</h5>
                <p class="card-text text-muted">Endpoints <code>/api/stagiaires</code> consommés en AJAX par le front-office.</p>
            </div>
        </div>
    </div>
</div>
