@model LoginViewModel
@{
    ViewData["Title"] = "Connexion";
    Layout = "_LayoutAuth";
}

<div class="auth-card">
    <!-- Panneau de marque -->
    <div class="auth-brand">
        <span class="auth-brand__circle auth-brand__circle--top"></span>
        <span class="auth-brand__circle auth-brand__circle--bottom"></span>

        <div class="auth-brand__content">
            <div class="brand-mark" style="color:#fff">
                <span class="brand-mark__badge">S</span>
                <span>Stages ONEE<small style="color:rgba(255,255,255,.75)">DSI · Direction SI</small></span>
            </div>
            <h1>Vos stages,<br />simplifiés.</h1>
            <p>Déposez vos candidatures, suivez vos dossiers, échangez avec vos encadrants — le tout en un seul endroit clair et rassurant.</p>
        </div>

        <div class="auth-brand__foot">© @DateTime.Now.Year ONEE · DSI</div>
    </div>

    <!-- Formulaire -->
    <div class="auth-form">
        <h2>Content de vous revoir</h2>
        <p class="auth-form__sub">Connectez-vous pour accéder à votre espace personnel.</p>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Adresse email institutionnelle <span class="req">*</span></label>
                <input asp-for="Email" class="form-control" type="email" autofocus
                       placeholder="prenom.nom@etablissement.ma" />
                <div class="field-hint"><i class="bi bi-star-fill text-accent" style="font-size:.6rem"></i> Universités marocaines partenaires uniquement</div>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mot de passe <span class="req">*</span></label>
                <input asp-for="Password" class="form-control" placeholder="••••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <div class="d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Se connecter&nbsp;→</button>
            </div>
        </form>

        <p class="text-center mt-4 mb-0">
            Nouveau ici ? <a asp-action="Register" class="text-accent fw-semibold">Créer un compte</a>
        </p>
        <p class="text-center text-muted small mt-2 mb-0">
            Démo : <code>admin@stagiaires.local</code> / <code>Admin@123</code>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
